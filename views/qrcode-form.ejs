<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Gerar QR Code</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/css/style.css?v=2">
</head>
<body>
  <div class="form-shell">
    <div class="form-card">
      <h2>Imprimir QR Code das mesas</h2>
      <% if (erro) { %>
        <div class="error-box"><%= erro %></div>
      <% } %>
      <form method="POST" action="/painel/qrcode">
        <div class="field">
          <label>Quantas mesas o restaurante tem?</label>
          <input type="number" name="quantidade" placeholder="Ex: 10" min="1" max="60" required>
        </div>
        <button class="button button-full" type="submit">Gerar QR Codes</button>
      </form>
      <a class="back-link" href="/painel">← Voltar ao painel</a>
    </div>
  </div>
</body>
</html>
