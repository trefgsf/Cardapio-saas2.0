<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login - Cardápio SaaS</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="auth-shell">
    <div class="auth-card">
      <h2>Bem-vindo de volta</h2>
      <p class="auth-subtitle">Entre para gerenciar seu cardápio.</p>
      <% if (erro) { %>
        <div class="error-box"><%= erro %></div>
      <% } %>
      <form method="POST" action="/login">
        <div class="field">
          <label>E-mail</label>
          <input type="email" name="email" placeholder="seu@email.com" required>
        </div>
        <div class="field">
          <label>Senha</label>
          <input type="password" name="senha" placeholder="••••••••" required>
        </div>
        <button class="button button-full" type="submit">Entrar</button>
      </form>
      <p class="auth-footer">Ainda não tem conta? <a href="/cadastro">Criar conta</a></p>
    </div>
  </div>
</body>
</html>
