<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Prato</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="form-shell">
    <div class="form-card">
      <h2><%= prato ? 'Editar Prato' : 'Novo Prato' %></h2>
      <% if (erro) { %>
        <div class="error-box"><%= erro %></div>
      <% } %>
      <form method="POST" action="<%= prato ? '/painel/editar/' + prato.id : '/painel/novo' %>" enctype="multipart/form-data">
        <div class="field">
          <label>Nome do prato</label>
          <input type="text" name="nome" placeholder="Ex: Pizza de Calabresa" value="<%= prato ? prato.nome : '' %>" required>
        </div>
        <div class="field">
          <label>Descrição</label>
          <textarea name="descricao" placeholder="Ingredientes, detalhes..."><%= prato ? prato.descricao : '' %></textarea>
        </div>
        <div class="field">
          <label>Preço (R$)</label>
          <input type="number" step="0.01" name="preco" placeholder="0.00" value="<%= prato ? prato.preco : '' %>" required>
        </div>
        <div class="field">
          <label>Foto do prato</label>
          <input type="file" name="foto" accept="image/*">
        </div>
        <button class="button button-full" type="submit">Salvar</button>
      </form>
      <a class="back-link" href="/painel">← Voltar ao painel</a>
    </div>
  </div>
</body>
</html>
